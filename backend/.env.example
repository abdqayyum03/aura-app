# App
NODE_ENV=development
PORT=3000

# Postgres / TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aura
DB_PASSWORD=aura_dev_password
DB_DATABASE=aura

# Redis
# Port 6380, not the default 6379 - see docker-compose.yml's redis service
# comment for why (avoids a real port collision with a sibling project's own
# local redis, e.g. one also named "backend" on this machine).
REDIS_HOST=localhost
REDIS_PORT=6380

# MQTT (EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_INGEST_TOPIC=aura/+/telemetry

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
